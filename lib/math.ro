const PI float = 3.141592653589793
const E float = 2.718281828459045

func fac(int number) (int) {
    var NewNumber int = 1
    var CI int = number
    while CI > 0 {
        NewNumber = NewNumber * CI
        CI = CI-1
    }
    return NewNumber
}

func exp_float(float number) (float) {
    return E ** number
}

func exp_int(int number) (float) {
    return E ** number
}

