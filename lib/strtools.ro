reach "conv"

# splits line with the letter 
func split(string name string letter) (list) {
    var new_list list = []
    var temp_string string = ""
    for i = (name) {
        if i == letter {
            new_list = append(new_list, temp_string)
            temp_string = ""
        } else {
            temp_string = temp_string + i
        }
    }
    if temp_string != "" {
        new_list = append(new_list,temp_string)

    }
    return new_list
}

func to_upper(string text) (char) {
    house NewString = ""
    for s = (text) {
        house B = to_char(s)
        if B >= 'a' && B <= 'z' {
            NewString = NewString+to_string(B-32)
        } else {
            NewString = NewString+s
        }
        
    }
    
    return NewString
}

func reaplace(string text string old string new) (string) {
    var newText string = ""
    house pos = 0
    while len(text)>pos  {
        
        if  pos+len(old)> len(text) {
            newText = newText+text[pos]
            pos = pos + 1
            continue
        } 
        if text[pos:pos+len(old)] == old{
            newText = newText+new
            pos = pos+len(old)+1
            continue
        }
        newText = newText+text[pos]
        pos = pos + 1
    }
    return newText
}